# =====================================================================
# Remarketing ABRADILAN — variáveis de ambiente
# Local: copie para .env e preencha.  Hostinger: cadastre no painel do app
# (veja DEPLOY-HOSTINGER.md). NUNCA suba o .env para o GitHub.
# As linhas comentadas (#) com segredos devem ser preenchidas à mão.
# =====================================================================

# ---------------------------------------------------------------- Mautic
MAUTIC_URL=https://mkt.maiscorporativo.tur.br
# MAUTIC_USER=
# MAUTIC_PASS=
# E-mails cujo NOME casa com esta expressão (regex, sem diferenciar maiúsculas)
EMAIL_NAME_PATTERN=^\s*\[ABRADILAN\]
# E-mails disparados a partir desta data entram no remarketing (valor inicial; depois escolha no painel)
EMAILS_DESDE=2026-11-01
# Só conta clique em link que contenha isto (ignora LinkedIn/Instagram/YouTube do rodapé)
SITE_URL_PATTERN=abradilan.mais.tur.br
# Formulário(s) de inscrição. Quem enviou não recebe nada (casamento por e-mail ou telefone)
FORM_IDS=31
# Etiqueta adicionada ao contato no Mautic depois do disparo
MAUTIC_TAG=abradilan-remarketing-whatsapp

# ---------------------------------------------------------------- Regras
# Espera X minutos depois do clique antes de abordar (dá tempo de a pessoa se inscrever sozinha)
DELAY_MINUTOS=120
# Ignora cliques mais antigos que X dias
JANELA_DIAS=365
# Intervalo entre verificações automáticas
INTERVALO_MINUTOS=15
# Máximo de disparos por verificação automática
MAX_POR_CICLO=30
# Pausa entre um disparo e outro, em segundos
PAUSA_ENTRE_ENVIOS=8
# 1 = envios automáticos começam PAUSADOS na primeira subida (depois vale o botão do painel)
DRY_RUN=1

# ---------------------------------------------------------------- Botconversa (conta 199342)
BOTCONVERSA_FLOW_ID=9414791
# BOTCONVERSA_API_KEY=
# Opcional: etiqueta no Botconversa (ID numérico) ou envio por webhook de fluxo em vez da API
# BOTCONVERSA_TAG_ID=
# BOTCONVERSA_WEBHOOK_URL=

# ---------------------------------------------------------------- CRM
# CRM_WEBHOOK_URL=https://crm.maiscorporativo.tur.br/api/v1/webhook/<uuid-do-funil>

# ---------------------------------------------------------------- Painel
PAINEL_USUARIO=abradilan
# PAINEL_SENHA=
# Local apenas (na Hostinger a porta vem automaticamente em PORT):
# PAINEL_PORTA=3010

# ---------------------------------------------------------------- Hospedagem
# Pasta FORA do app onde fica o banco (senão cada deploy apaga os dados):
# DATA_DIR=/home/SEU_USUARIO/dados-remarketing
# Senha do agendador externo (n8n chama POST /api/cron com o cabeçalho X-Cron-Token):
# CRON_TOKEN=
